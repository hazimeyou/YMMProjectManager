<UserControl
    x:Class="YMMProjectManager.Presentation.Views.ProjectListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="clr-namespace:YMMProjectManager.Presentation.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnLoaded"
    AllowDrop="True"
    PreviewDragOver="OnPreviewDragOver"
    Drop="OnDrop"
    MinWidth="320"
    MinHeight="240">

    <Grid Margin="8">
        <DockPanel>
            <!-- 基本操作: プロジェクト一覧の追加・削除・起動を行う。 -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button Content="追加" Width="90" Margin="0,0,8,0" Command="{Binding AddCommand}" />
                <Button Content="削除" Width="90" Margin="0,0,8,0" Command="{Binding RemoveCommand}" />
                <Button Content="開く" Width="90" Margin="0,0,8,0" Command="{Binding OpenCommand}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding ProjectListPublicationStatus}" TextWrapping="Wrap" />
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="一覧に未保存の変更があります。" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnsavedProjectList}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="一覧の保存を再試行" Command="{Binding RetryProjectListSaveCommand}" />
                <Button Content="ID 設定の競合を回復" Command="{Binding RecoverIdentityCommand}" Margin="4,0,0,0" />
                <Button Content="一覧変更の競合を確認" Command="{Binding RecoverProjectListCommand}" Margin="4,0,0,0" />
                <Button Content="退避一覧を保存" Command="{Binding ExportRecoverySnapshotCommand}" Margin="4,0,0,0" />
                <Button Content="画面状態を退避" Command="{Binding ExportRecoveryScreenCommand}" Margin="4,0,0,0" />
                <Button Content="中断された一覧保存を確認" Command="{Binding RecoverProjectListPublicationCommand}" Margin="4,0,0,0" />
                <Button Content="前回の保存記録を確認" Command="{Binding ReviewDraftCommand}" Margin="4,0,0,0" />
                <Button Content="一覧原本を退避" Command="{Binding ExportOriginalProjectListCommand}" Margin="4,0,0,0" />
                <Button Content="一覧の ID を確認・修復" Command="{Binding RepairProjectListIdentitiesCommand}" Margin="4,0,0,0" />
            </WrapPanel>

            <!-- YMM 本体と連携する操作は、通常の一覧操作と分けて配置する。 -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button
                    Content="再リンク"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Command="{Binding OpenRelinkWindowCommand}" />
                <Button
                    Content="サムネイル生成"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Command="{Binding GenerateThumbnailsFastCommand}" />
                <Button
                    Content="ymmpx展開"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Command="{Binding ExtractBundleCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button
                    Content="選択したプロジェクトを同梱"
                    MinWidth="139"
                    Margin="0,0,8,0"
                    Command="{Binding PackageSelectedProjectCommand}" />
                <Button
                    Content="現在のプロジェクトを同梱"
                    MinWidth="139"
                    Margin="0,0,8,0"
                    Command="{Binding PackageOpenedProjectCommand}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding BundleStatus}" Margin="0,0,0,6" />
            <ProgressBar DockPanel.Dock="Top" Height="20" Minimum="0" Maximum="100" Value="{Binding BundleProgress}" />
            <Button DockPanel.Dock="Top" Content="処理を中止" HorizontalAlignment="Left" Command="{Binding CancelToolCommand}" Margin="0,4,0,4" />
            <Expander DockPanel.Dock="Top" Header="Git と素材" Margin="0,4,0,4">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="ブランチ" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Width="150" Text="{Binding GitBranch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" />
                <Button Content="作成" Command="{Binding CreateGitBranchCommand}" Margin="0,0,4,0" />
                <Button Content="切替" Command="{Binding SwitchGitBranchCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,6,0,0">
                <Button Content="Git 状態" MinWidth="90" Margin="0,0,8,0" Command="{Binding RefreshGitStatusCommand}" />
                <Button Content="Git 初期化" MinWidth="90" Command="{Binding InitializeGitCommand}" />
                <Button Content="履歴" Command="{Binding GitHistoryCommand}" Margin="4,0,0,0" />
                <Button Content="origin" Command="{Binding GitOriginCommand}" Margin="4,0,0,0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding GitStatus}" TextWrapping="Wrap" Margin="0,4,0,6" />
            <TextBlock Text="Clone・Fetch・Push は操作ごとに信頼を確認します。Pull は使用できません。" TextWrapping="Wrap" Margin="0,0,0,4" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="Fetch" Command="{Binding FetchGitCommand}" Margin="0,0,4,0" />
                <Button Content="Pull (fast-forward)" Command="{Binding PullGitCommand}" Margin="0,0,4,0" />
                <Button Content="Pull 前の状態を確認" Command="{Binding InspectGitPullCommand}" Margin="0,0,4,0" />
                <Button Content="Push" Command="{Binding PushGitCommand}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="clone URL" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Width="200" Text="{Binding GitRemote, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" />
                <TextBox Width="120" Text="{Binding GitCloneName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="新規フォルダー名" />
                <Button Content="clone" Command="{Binding GitCloneCommand}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="プロジェクトからの相対パス" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Width="150" Text="{Binding GitPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" />
                <Button Content="ステージ" Command="{Binding StageGitPathCommand}" Margin="0,0,4,0" />
                <Button Content="解除" Command="{Binding UnstageGitPathCommand}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="メッセージ" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Width="150" Text="{Binding GitCommitMessage, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" />
                <Button Content="コミット" Command="{Binding CommitGitCommand}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="素材候補" Command="{Binding FindAssetCandidatesCommand}" Margin="0,0,4,0" />
                <Button Content="旧項目に ID を設定" Command="{Binding AssignLegacyProjectIdCommand}" Margin="0,0,4,0" />
                <Button Content="旧 metadata を関連付け" Command="{Binding AssociateLegacyMetadataCommand}" Margin="0,0,4,0" />
                <Button Content="選択プロジェクトを再リンク" Command="{Binding OpenSelectedProjectRelinkCommand}" Margin="0,0,4,0" />
                <TextBlock Text="相対パス（1行に1件）" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Width="150" Height="48" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding AssetPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" />
                <Button Content="素材検査" Command="{Binding InspectAssetCommand}" Margin="0,0,4,0" />
                <Button Content="メタデータ保存" Command="{Binding ExportAssetMetadataCommand}" />
                <Button Content="新しい版を保存" Command="{Binding UpdateAssetMetadataCommand}" Margin="4,0,0,0" />
                <Button Content="メタデータ照合" Command="{Binding VerifyAssetMetadataCommand}" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="HTTPS URL (任意)" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Width="220" Text="{Binding AssetUrl, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedProject.ProjectId, StringFormat='Project ID: {0}', TargetNullValue='Project ID: 未設定'}" Margin="0,4,0,0" />
            <WrapPanel Margin="0,4,0,4">
                <TextBlock Text="保管先名" Margin="0,0,4,0" />
                <TextBox Width="100" Text="{Binding AssetStorageName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" />
                <TextBlock Text="保管先からの相対パス" Margin="0,0,4,0" />
                <TextBox Width="145" Text="{Binding AssetStoragePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" />
                <Button Content="外部素材を検査" Command="{Binding InspectExternalAssetCommand}" />
                <Button Content="登録済み素材をまとめて照合" Command="{Binding VerifyStoredExternalAssetsCommand}" Margin="4,0,0,0" />
            </WrapPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding AssetStatus}" TextWrapping="Wrap" Margin="0,4,0,6" />
            <WrapPanel Margin="0,0,0,4">
                <Button Content="移動・改名先を指定" Command="{Binding ReassociateProjectCommand}" Margin="0,0,4,0" />
                <Button Content="識別情報を照合" Command="{Binding VerifyProjectIdentityCommand}" Margin="0,0,4,0" />
                <Button Content="旧メタデータ履歴を取り込む" Command="{Binding ImportMetadataSeriesCommand}" Margin="0,0,4,0" />
                <Button Content="履歴の版を選択" Command="{Binding SelectMetadataSeriesCommand}" Margin="0,0,4,0" />
                <Button Content="関連付けと素材を照合" Command="{Binding InspectMetadataSeriesCommand}" />
                <Button Content="同じ履歴の移動先を指定" Command="{Binding RebindMetadataDirectoryCommand}" Margin="4,0,0,0" />
            </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Expander>

            <ListBox
                ItemsSource="{Binding Projects}"
                SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                MouseDoubleClick="OnProjectListMouseDoubleClick"
                PreviewMouseRightButtonDown="OnProjectListPreviewMouseRightButtonDown">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="世代を保存" Click="OnSaveGenerationMenuClick" />
                        <MenuItem Header="世代一覧" Click="OnShowGenerationListMenuClick" />
                        <MenuItem Header="世代診断" Click="OnShowGenerationDiagnosticsMenuClick" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:ScrubThumbnailControl
                                Grid.Column="0"
                                CacheDirectory="{Binding ThumbnailCacheDirectory}" />

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EffectiveDisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FullPath}" FontSize="11" Opacity="0.8" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
