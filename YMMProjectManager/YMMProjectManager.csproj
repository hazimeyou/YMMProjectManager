<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>YMMProjectManager</AssemblyName>
    <Version Condition="'$(Version)'==''">0.4.0</Version>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(YMM4Path)\YukkuriMovieMaker.Plugin.dll')">
    <Reference Include="YukkuriMovieMaker.Plugin" HintPath="$(YMM4Path)\YukkuriMovieMaker.Plugin.dll" Private="false" />
    <Reference Include="YukkuriMovieMaker.Controls" HintPath="$(YMM4Path)\YukkuriMovieMaker.Controls.dll" Private="false" />
    <Reference Include="YukkuriMovieMaker" HintPath="$(YMM4Path)\YukkuriMovieMaker.dll" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(YMM4Path)\YukkuriMovieMaker.Plugin.dll')">
    <Reference Include="YukkuriMovieMaker.Plugin" HintPath="..\libs\YukkuriMovieMaker.Plugin.dll" Private="false" />
    <Reference Include="YukkuriMovieMaker.Controls" HintPath="..\libs\YukkuriMovieMaker.Controls.dll" Private="false" />
    <Reference Include="YukkuriMovieMaker" HintPath="..\libs\YukkuriMovieMaker.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployToYMM4" DependsOnTargets="Build">
    <Error Condition="'$(YMM4DeployPath)' == ''"
           Text="Set YMM4DeployPath to explicitly select the YMM4 installation for development deployment." />
    <Error Condition="!Exists('$(YMM4DeployPath)\YukkuriMovieMaker.Plugin.dll')"
           Text="YMM4DeployPath must point to a YMM4 directory containing YukkuriMovieMaker.Plugin.dll." />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(YMM4DeployPath)\user\plugin\$(AssemblyName)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
