<Project>
  <PropertyGroup>
    <YMM4Path Condition="'$(YMM4Path)' == '' and '$(YMM4_PATH)' != ''">$(YMM4_PATH)</YMM4Path>
    <YMM4Path Condition="'$(YMM4Path)' == '' and '$(YMM4DirPath)' != ''">$(YMM4DirPath)</YMM4Path>
    <YMM4Path Condition="'$(YMM4Path)' == ''">$(MSBuildThisFileDirectory)libs/YMM4</YMM4Path>
  </PropertyGroup>
</Project>
